# ============================================================================
# Stadtwerke Plattling - Production Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the actual values before deploying.
# DO NOT commit .env to version control - it contains sensitive credentials.
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
PORT=4000

# Public base URL for RSS feed and other public-facing links (HTTPS only)
# Example: https://stoerung.stadtwerke-plattling.de
PUBLIC_BASE_URL={{PRODUCTION_DOMAIN}}

# Database file path (optional - defaults to server/data/db.json)
# DATA_FILE=/path/to/custom/db.json

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Set to "true" to disable authentication (NOT recommended for production)
# AUTH_DISABLED=true

# Team name displayed in the app
AUTH_TEAM=Stadtwerke Plattling

# Worker accounts with personal PINs (format: id:Name:pin;id:Name:pin)
# Minimum 6 digits per PIN. Example:
# WORKERS=swp-01:Anna Huber:123456;swp-02:Max Bauer:654321;swp-03:Sabine Reiter:789012

# Brute force protection
AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=10

# ----------------------------------------------------------------------------
# Heimat-Info Integration
# ----------------------------------------------------------------------------
# Heimat-Info API endpoint
HEIMATINFO_BASE_URL=https://heimatinfo-api-platform-dev.azurewebsites.net

# Heimat-Info credentials (get these from the challenge organizers)
HEIMATINFO_ORG_ID={{HEIMATINFO_ORG_ID}}
HEIMATINFO_API_KEY={{HEIMATINFO_API_KEY}}

# Post status: "Draft" (invisible) or "Published" (visible to public)
# Use Draft for testing, Published for production
HEIMATINFO_STATUS=Published

# ----------------------------------------------------------------------------
# Geocoding (OpenStreetMap reverse geocoding)
# ----------------------------------------------------------------------------
# Set to "true" to disable geocoding
# GEOCODING_DISABLED=true

# Custom geocoding URL (optional - defaults to Nominatim)
# GEOCODING_URL=https://nominatim.openstreetmap.org/reverse

# User agent for geocoding requests
GEOCODING_AGENT=Stadtwerke-Plattling/1.0 (municipal outage tool)

# ----------------------------------------------------------------------------
# Automatic Updates
# ----------------------------------------------------------------------------
# Set to "true" to disable automatic 30-minute updates
# AUTO_UPDATE_DISABLED=true

# Interval between automatic updates (in minutes)
AUTO_UPDATE_MINUTES=30
